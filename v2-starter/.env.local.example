# Earth Simulator V2 — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Supabase (Edge Function proxy + telemetry)
# Dashboard → Project Settings → API → Project URL + anon public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Local dev only — enables /api/parse-scenario when the Supabase edge function is down.
# NOT prefixed with VITE_ so it never reaches the browser bundle.
# Production: set the same key as a Supabase secret instead:
#   npx supabase secrets set ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
