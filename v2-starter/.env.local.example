# Earth Simulator V2 — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Supabase (Edge Function proxy + telemetry)
# Dashboard → Project Settings → API → Project URL + anon public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Anthropic API key lives ONLY in Supabase Edge Function secrets:
#   npx supabase secrets set ANTHROPIC_API_KEY=your_key_here
# Do NOT put Claude keys in the browser.
